<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>LadderViewer</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Ladder Viewer</Product>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../package.json')), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="../LICENSE" LogicalName="LadderViewer.LICENSE" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="LadderViewer.THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="app.ico" LogicalName="LadderViewer.app.ico" />
    <EmbeddedResource Include="$(IntermediateOutputPath)web.zip" LogicalName="LadderViewer.web.zip" />
  </ItemGroup>
  <Target Name="RemoveUnusedWpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
  <Target Name="ZipWebAssets" BeforeTargets="PrepareResources">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../artifacts/build/web/index.html')" Text="Run npm run build before publishing the Windows app." />
    <ItemGroup>
      <InputCsv Include="$(MSBuildProjectDirectory)/../artifacts/build/web/**/*.csv;$(MSBuildProjectDirectory)/../artifacts/build/web/**/*.mnm" />
    </ItemGroup>
    <Error Condition="'@(InputCsv)' != ''" Text="Input CSV/MNM files must not be embedded. Remove input files from the web build output before publishing." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)/../artifacts/build/web" DestinationFile="$(IntermediateOutputPath)web.zip" Overwrite="true" />
  </Target>
</Project>
