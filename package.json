{
  "name": "ladder-viewer-prototype",
  "version": "0.6.7",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "windows:build": "npm run build && dotnet publish src-desktop/LadderViewer.csproj -c Release -r win-x64 --self-contained false -o artifacts/release"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "papaparse": "^5.7.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
